// Booking System Schema Template
// Includes: Services, Resources, Appointments, Availability, Payments

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SERVICES & RESOURCES
// ============================================

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?   @db.Text

  // Pricing
  price       Decimal   @db.Decimal(10, 2)
  currency    String    @default("USD")

  // Duration in minutes
  duration    Int
  bufferBefore Int      @default(0)
  bufferAfter  Int      @default(0)

  // Capacity
  maxParticipants Int   @default(1)

  // Settings
  requiresConfirmation Boolean @default(false)
  allowCancellation    Boolean @default(true)
  cancellationDeadline Int     @default(24) // hours before

  // Status
  active      Boolean   @default(true)

  // Organization
  category    ServiceCategory? @relation(fields: [categoryId], references: [id])
  categoryId  String?

  // Relations
  bookings    Booking[]
  resources   ResourcesOnServices[]
  availability ServiceAvailability[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([active])
  @@map("services")
}

model ServiceCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?

  services    Service[]

  @@map("service_categories")
}

model Resource {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        ResourceType

  // Capacity (for rooms, equipment)
  capacity    Int       @default(1)

  // Status
  active      Boolean   @default(true)

  // For staff resources
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?   @unique

  // Relations
  services    ResourcesOnServices[]
  bookings    Booking[]
  availability ResourceAvailability[]
  blockedTimes BlockedTime[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@map("resources")
}

model ResourcesOnServices {
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId  String
  resource   Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String
  required   Boolean   @default(true)

  @@id([serviceId, resourceId])
  @@map("resources_on_services")
}

// ============================================
// AVAILABILITY
// ============================================

model ServiceAvailability {
  id          String    @id @default(cuid())
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId   String

  dayOfWeek   Int       // 0 = Sunday, 6 = Saturday
  startTime   String    // "09:00"
  endTime     String    // "17:00"

  @@unique([serviceId, dayOfWeek, startTime])
  @@map("service_availability")
}

model ResourceAvailability {
  id          String    @id @default(cuid())
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId  String

  dayOfWeek   Int
  startTime   String
  endTime     String

  @@unique([resourceId, dayOfWeek, startTime])
  @@map("resource_availability")
}

model BlockedTime {
  id          String    @id @default(cuid())
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId  String

  startTime   DateTime
  endTime     DateTime
  reason      String?
  recurring   Boolean   @default(false)

  createdAt   DateTime  @default(now())

  @@index([resourceId, startTime, endTime])
  @@map("blocked_times")
}

// ============================================
// BOOKINGS
// ============================================

model Booking {
  id          String        @id @default(cuid())
  bookingNumber String      @unique @default(cuid())

  // Service
  service     Service       @relation(fields: [serviceId], references: [id])
  serviceId   String

  // Resource (staff/room)
  resource    Resource?     @relation(fields: [resourceId], references: [id])
  resourceId  String?

  // Customer
  customer    User          @relation("CustomerBookings", fields: [customerId], references: [id])
  customerId  String

  // Guest booking (no account)
  guestName   String?
  guestEmail  String?
  guestPhone  String?

  // Timing
  startTime   DateTime
  endTime     DateTime

  // Participants
  participants Int          @default(1)

  // Status
  status      BookingStatus @default(PENDING)

  // Pricing
  price       Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")

  // Notes
  customerNotes String?     @db.Text
  internalNotes String?     @db.Text

  // Cancellation
  cancelledAt   DateTime?
  cancelledBy   String?
  cancelReason  String?

  // Relations
  payment     Payment?
  reminders   Reminder[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([bookingNumber])
  @@index([customerId])
  @@index([status, startTime])
  @@index([resourceId, startTime, endTime])
  @@map("bookings")
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id          String        @id @default(cuid())

  booking     Booking       @relation(fields: [bookingId], references: [id])
  bookingId   String        @unique

  // Amount
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")

  // Status
  status      PaymentStatus @default(PENDING)

  // Provider
  provider    String?       // stripe, paypal, etc.
  providerId  String?       // External payment ID

  // Metadata
  metadata    Json?

  paidAt      DateTime?
  refundedAt  DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([providerId])
  @@map("payments")
}

// ============================================
// REMINDERS
// ============================================

model Reminder {
  id          String        @id @default(cuid())

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String

  type        ReminderType
  scheduledAt DateTime
  sentAt      DateTime?

  @@index([scheduledAt, sentAt])
  @@map("reminders")
}

// ============================================
// USER
// ============================================

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  phone       String?
  role        UserRole  @default(CUSTOMER)

  // Relations
  bookings    Booking[] @relation("CustomerBookings")
  resource    Resource? // If staff member

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

// ============================================
// ENUMS
// ============================================

enum ResourceType {
  STAFF
  ROOM
  EQUIPMENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReminderType {
  EMAIL_24H
  EMAIL_1H
  SMS_24H
  SMS_1H
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}
