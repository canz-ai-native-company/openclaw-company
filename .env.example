# Copy this file to  ~/.openclaw/.env  on each laptop and fill REAL values.
# .env is gitignored - it must NEVER be committed or pushed.
# setup.sh (step 8) injects these into the MCP server configs.

# neon-postgres MCP (read+write, all 7 agents) - full Postgres connection string
NEON_DATABASE_URL=

# hubspot MCP (main agent) - HubSpot private app access token
HUBSPOT_TOKEN=

# higgsfield MCP (designer-and-creatives) - full Authorization header value (e.g. "Bearer xxx")
HIGGSFIELD_AUTH=

# nanobanana MCP (designer-and-creatives, fullstack-developer) - Google Gemini API key
GEMINI_API_KEY=

# context7 MCP (all 7 agents) needs NO secret.
