# Copy this file to .env and fill REAL values.
# .env is gitignored — it must NEVER be committed or pushed.
# These names are referenced by setup.sh (step 7) as openclaw ENV REFS.

# --- System of record (Neon Postgres) ---
NEON_DATABASE_URL=

# --- CRM intake (HubSpot) ---
HUBSPOT_TOKEN=

# --- Client delivery (GoHighLevel) ---
GHL_TOKEN=

# --- Approvals / messaging (Slack) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Creative generation ---
HIGGSFIELD_API_KEY=
NANOBANANA_API_KEY=

# NOTE: confirm the exact set of secrets your MCP servers require, and that
# these env vars are exported in the openclaw RUNTIME environment (e.g. ~/.bashrc),
# because openclaw resolves ENV REFS at run time, not only during setup.sh.
